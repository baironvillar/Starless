{
  "name": "starless",
  "private": true,
  "version": "0.7.0-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "app:build": "tauri build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "hooks:install": "bunx star init hooks",
    "design:detect": "impeccable detect src/",
    "logo": "bun run scripts/logo.ts",
    "logo:icons": "bun run scripts/logo.ts --icons",
    "logo:invert": "bun run scripts/logo.ts --invert",
    "logo:android": "bun run scripts/logo.ts --android",
    "typecheck": "tsc --noEmit && tsc --noEmit -p relay",
    "relay:test": "bun test relay",
    "test": "bun test",
    "relay:deploy": "bunx wrangler deploy --config relay/wrangler.toml",
    "version": "bunx star version",
    "version:set": "bunx star version set",
    "release": "bunx star release",
    "release:notes": "bunx star notes",
    "doctor": "bunx star doctor"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@baironvillar/star": "github:baironvillar/star#v0.5.0",
    "@biomejs/biome": "^2.5.15",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "star": {
    "gate": [
      "bun run lint",
      "bun run typecheck",
      "bun run test",
      "cargo test --lib --manifest-path src-tauri/Cargo.toml"
    ]
  }
}
