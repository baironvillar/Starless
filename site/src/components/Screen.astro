---
/**
 * A drawing of the app, not a photograph of it.
 *
 * **Why it is drawn.** The captures that used to be here were photographs of a
 * real account: its playlists, its songs, its name and the artwork of other
 * people's records. `public/` is published with the site, so a photograph in
 * it is a disclosure. A drawing is not: the covers are gradients that belong
 * to nobody and the names are bars, so what the landing shows is the app and
 * not the person who was looking at it.
 *
 * **What is left is the furniture, and the furniture is the product.** The
 * promise of the landing is a window that does not ask for attention, and
 * that promise lives in the chrome: the glass, the riel, the hairline table of
 * tracks, the bar that comes with the music. A photograph of somebody's library
 * sells a screenshot; this sells the app.
 *
 * **The app's own words stay.** "Tu biblioteca", "Cola de reproducción",
 * "AHORA SUENA", "Orden personalizado" are the app's chrome, in the app's
 * language, and they are what makes the drawing readable as the app and not
 * as a wireframe. Only the content is withheld.
 *
 * **Everything is drawn at 1440 and scaled by one unit.** `--u` is a hundredth
 * of the design width and every size is a multiple of it, so the drawing is
 * the same app at the size of the window that holds it — a window on a landing
 * page is about half the width of the app it shows.
 *
 * **No `backdrop-filter` here.** The four screens are stacked and cross-faded
 * with an opacity animation, and a blur behind a surface that animates means
 * re-sampling the blur on every frame of the fade. The glass is drawn with its
 * translucency and its shadow instead: nothing sits behind these panels that
 * a blur would reveal.
 */
type Props = {
  variant: "library" | "playlist" | "queue" | "settings";
};
const { variant } = Astro.props;

const ICONS: Record<string, string> = {
  house:
    '<path d="M3 10a2 2 0 0 1 .7-1.5l7-6a2 2 0 0 1 2.6 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>',
  library: '<path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  users:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  settings:
    '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
  more: '<circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>',
  minimize: '<path d="M5 12h14"/>',
  maximize: '<rect x="5" y="5" width="14" height="14" rx="1.5"/>',
  close: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  shuffle:
    '<path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.8-1.1 2-1.7 3.3-1.7H22"/><path d="m18 2 4 4-4 4"/><path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"/><path d="M22 18h-5.9c-1.3 0-2.6.7-3.3 1.8l-.5.8"/><path d="m18 14 4 4-4 4"/>',
  prev: '<path d="M19 20 9 12l10-8z"/><path d="M5 19V5"/>',
  next: '<path d="m5 4 10 8-10 8z"/><path d="M19 5v14"/>',
  repeat:
    '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
  volume:
    '<path d="M11 4.7 6.6 8H3v8h3.6L11 19.3z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/>',
  queue:
    '<path d="M10 6h11"/><path d="M10 12h11"/><path d="M10 18h11"/><path d="M4 6h1v4"/><path d="M4 10h2"/><path d="M6 18H4c0-1 2-2 2-3"/>',
  mic: '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  panel: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/>',
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  sort: '<path d="m21 16-4 4-4-4"/><path d="M17 20V4"/><path d="m3 8 4-4 4 4"/><path d="M7 4v16"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/>',
  list: '<path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/>',
  play: '<path d="m6 3 14 9-14 9z"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  pencil:
    '<path d="M21.2 6.8a2.8 2.8 0 0 0-4-4L3.8 16.2a2 2 0 0 0-.5.8l-1.3 4.4a.5.5 0 0 0 .6.6l4.4-1.3a2 2 0 0 0 .8-.5z"/>',
  pause:
    '<rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/>',
};

const icon = (name: string, size = 18) =>
  `<svg style="width:calc(${size} * var(--u));height:calc(${size} * var(--u))" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;

const iconFilled = (name: string, size = 18) =>
  `<svg style="width:calc(${size} * var(--u));height:calc(${size} * var(--u))" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">${ICONS[name]}</svg>`;

/** The heart of Liked Songs, drawn the way the app draws it. */
const likedCover = `<svg class="m-liked" viewBox="0 0 100 100" aria-hidden="true"><defs><linearGradient id="ml-plate" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#24242c"/><stop offset="1" stop-color="#0b0b0f"/></linearGradient><radialGradient id="ml-haze" cx="0.5" cy="0.62" r="0.55"><stop offset="0" stop-color="#ff5a36" stop-opacity="0.32"/><stop offset="1" stop-color="#ff5a36" stop-opacity="0"/></radialGradient></defs><rect width="100" height="100" fill="url(#ml-plate)"/><rect width="100" height="100" fill="url(#ml-haze)"/><circle cx="50" cy="50" r="36" fill="none" stroke="#c4c1c8" stroke-opacity="0.3" stroke-width="4"/><path d="M50 69C50 69 30 57 30 43.5C30 36 35.5 31 42 31C45.8 31 48.6 33.2 50 36.4C51.4 33.2 54.2 31 58 31C64.5 31 70 36 70 43.5C70 57 50 69 50 69Z" fill="#ff5a36"/></svg>`;

/** How many of each thing a window shows. */
const SHELF = 8;
const TILES = 6;
const TRACKS = 10;
const QUEUED = 5;

/** Bars are the width of the word they stand for; these are the widths. */
const TITLE_BARS = [150, 96, 176, 124, 84];

/** The app's accent presets, in its order (`ACCENT_PRESETS` in SettingsPanel.tsx). */
const ACCENTS = ["#ff5a36", "#7c6cff", "#3dd6c4", "#f5b83d", "#c4c1c8", "#ff8fb1"];

import { t } from "../i18n";
---

<div class="m" data-variant={variant}>
  {
    variant !== "settings" && (
      <div class="m-top">
        <div class="m-top-l">
          <span class="m-home"><Fragment set:html={icon("house", 18)} /></span>
          <span class="m-div" />
          <span class="m-pill">
            <Fragment set:html={icon("library", 16)} />
            <span data-i18n="screen.your-library" set:html={t("screen.your-library")}></span>
          </span>
        </div>
        <div class="m-search">
          <Fragment set:html={icon("search", 16)} />
          <span data-i18n="screen.search-songs" set:html={t("screen.search-songs")}></span>
        </div>
        <div class="m-top-r">
          {/* One gear, as in the app: friends, the mixer and the overflow menu used to sit here and are gone. */}
          <span class="m-icbtn"><Fragment set:html={icon("settings", 17)} /></span>
          <span class="m-div" />
          <span class="m-win"><Fragment set:html={icon("minimize", 14)} /></span>
          <span class="m-win"><Fragment set:html={icon("maximize", 13)} /></span>
          <span class="m-win"><Fragment set:html={icon("close", 14)} /></span>
        </div>
      </div>
    )
  }

  {
    variant === "library" && (
      <>
        <aside class="m-panel">
          <div class="m-panel-h">
            <span class="m-panel-t" data-i18n="screen.your-library" set:html={t("screen.your-library")}></span>
            <span class="m-icbtn"><Fragment set:html={icon("panel", 16)} /></span>
          </div>
          <div class="m-panel-c">
            <span class="m-icbtn"><Fragment set:html={icon("plus", 16)} /></span>
            <span class="m-icbtn"><Fragment set:html={icon("sort", 16)} /></span>
            <span class="m-icbtn m-on"><Fragment set:html={icon("grid", 16)} /></span>
          </div>
          <div class="m-tiles">
            <div class="m-tile">
              <span class="m-cover m-cover-liked"><Fragment set:html={likedCover} /></span>
              <span class="m-cap" data-i18n="screen.liked-songs" set:html={t("screen.liked-songs")}></span>
            </div>
            {Array.from({ length: TILES }).map((_, i) => (
              <div class="m-tile">
                <span class={`m-cover m-cv${(i % 6) + 1}`} />
                <span
                  class="m-bar"
                  style={`width:calc(${78 + (i % 3) * 12} * var(--u))`}
                />
              </div>
            ))}
          </div>
        </aside>

        <div class="m-main m-main-panel">
          <h1 class="m-h1" data-i18n="screen.home" set:html={t("screen.home")}></h1>
          <p class="m-sub" data-i18n="screen.playlists-count" data-i18n-count="24" set:html={t("screen.playlists-count", { count: 24 })}></p>
          <div class="m-shelf">
            {Array.from({ length: SHELF }).map((_, i) => (
              <div class="m-card">
                <span class={`m-cover m-cv${(i % 6) + 1}`} />
                <span
                  class="m-bar"
                  style={`width:calc(${110 + (i % 3) * 22} * var(--u))`}
                />
                <span
                  class="m-count"
                  data-i18n="screen.songs-count"
                  data-i18n-count={12 + (i % 4) * 7}
                  set:html={t("screen.songs-count", { count: 12 + (i % 4) * 7 })}
                ></span>
              </div>
            ))}
          </div>
        </div>
      </>
    )
  }

  {
    (variant === "playlist" || variant === "queue") && (
      <>
        <aside class="m-rail">
          <span class="m-icbtn"><Fragment set:html={icon("panel", 16)} /></span>
          <div class="m-rail-l">
            <span class="m-cover m-cover-liked"><Fragment set:html={likedCover} /></span>
            {Array.from({ length: 5 }).map((_, i) => (
              <span class={`m-cover m-cv${(i % 6) + 1}`} />
            ))}
          </div>
        </aside>

        <div class={`m-main m-main-rail${variant === "queue" ? " m-main-queue" : ""}`}>
          <div class="m-pl-head">
            <span class="m-cover m-pl-cover m-cv3" />
            <div class="m-pl-title">
              <span class="m-bar m-bar-lg" style="width:calc(300 * var(--u))" />
              <div class="m-pl-meta">
                <span class="m-ava" />
                <span class="m-bar m-bar-sm" style="width:calc(110 * var(--u))" />
                <span class="m-dot" />
                <span class="m-meta-t" data-i18n="screen.24-songs-1-h-12-min" set:html={t("screen.24-songs-1-h-12-min")}></span>
              </div>
            </div>
          </div>

          <div class="m-pl-actions">
            <span class="m-play"><Fragment set:html={iconFilled("play", 22)} /></span>
            <span class="m-icbtn"><Fragment set:html={icon("shuffle", 20)} /></span>
            <span class="m-icbtn"><Fragment set:html={icon("more", 20)} /></span>
            <span class="m-pl-right">
              <span class="m-icbtn"><Fragment set:html={icon("search", 16)} /></span>
              <span class="m-order" data-i18n="screen.custom-order" set:html={t("screen.custom-order")}></span>
              <span class="m-icbtn"><Fragment set:html={icon("list", 16)} /></span>
            </span>
          </div>

          <div class="m-table">
            <div class="m-thead">
              <span>#</span>
              <span />
              <span data-i18n="screen.title" set:html={t("screen.title")}></span>
              <span data-i18n="screen.album" set:html={t("screen.album")}></span>
              <span data-i18n="screen.date-added" set:html={t("screen.date-added")}></span>
              <span class="m-tright"><Fragment set:html={icon("clock", 14)} /></span>
            </div>
            {Array.from({ length: TRACKS }).map((_, i) => (
              <div class={`m-trow${i === 0 ? " m-trow-now" : ""}`}>
                <span class="m-tnum">{i + 1}</span>
                <span class={`m-cover m-cov-sm m-cv${(i % 6) + 1}`} />
                <span class="m-tmain">
                  <span
                    class="m-bar"
                    style={`width:calc(${120 + (i % 4) * 26} * var(--u))`}
                  />
                  <span
                    class="m-bar m-bar-sm"
                    style={`width:calc(${70 + (i % 3) * 20} * var(--u))`}
                  />
                </span>
                <span class="m-talbum">
                  <span class="m-bar m-bar-sm" style="width:calc(96 * var(--u))" />
                </span>
                <span class="m-tdate">—</span>
                <span class="m-tlen">{2 + (i % 5)}:{i % 2 ? "47" : "12"}</span>
              </div>
            ))}
          </div>
        </div>
      </>
    )
  }

  {
    variant === "queue" && (
      <aside class="m-queue">
        <div class="m-q-h">
          <span class="m-q-t" data-i18n="screen.play-queue" set:html={t("screen.play-queue")}></span>
          <span class="m-icbtn"><Fragment set:html={icon("users", 16)} /></span>
          <span class="m-icbtn"><Fragment set:html={icon("close", 16)} /></span>
        </div>
        <p class="m-q-eyebrow" data-i18n="screen.now-playing" set:html={t("screen.now-playing")}></p>
        <div class="m-q-now">
          <span class={`m-cover m-cov-sm m-cv2`} />
          <span class="m-tmain">
            <span class="m-bar" style="width:calc(120 * var(--u))" />
            <span class="m-bar m-bar-sm" style="width:calc(78 * var(--u))" />
          </span>
        </div>
        <p class="m-q-eyebrow" data-i18n="screen.next-up" set:html={t("screen.next-up")}></p>
        {Array.from({ length: QUEUED }).map((_, i) => (
          <div class="m-q-row">
            <span class="m-tnum">{i + 1}</span>
            <span class={`m-cover m-cov-sm m-cv${(i % 6) + 1}`} />
            <span class="m-tmain">
              <span class="m-bar" style={`width:calc(${88 + (i % 3) * 18} * var(--u))`} />
              <span class="m-bar m-bar-sm" style="width:calc(64 * var(--u))" />
            </span>
            <span class="m-tlen">3:{i % 2 ? "24" : "08"}</span>
          </div>
        ))}
      </aside>
    )
  }

  {
    variant === "settings" && (
      <>
        {/* What is behind the sheet. The real settings is a sheet over the
            window, and a sheet over nothing reads as a hole: these two
            glows are what the app's own light leaves under the glass, and
            they are the only thing that says "there is an app there". */}
        <div class="m-behind">
          <span class="m-b-warm" />
          <span class="m-b-cool" />
        </div>
        <div class="m-sheet">
          <nav class="m-sheet-nav">
            <h2 class="m-sheet-h" data-i18n="screen.settings" set:html={t("screen.settings")}></h2>
            <p class="m-sheet-sub" data-i18n="screen.audio-account-and-diagnostics" set:html={t("screen.audio-account-and-diagnostics")}></p>
            <span class="m-navitem">General</span>
            <span class="m-navitem">Audio</span>
            <span class="m-navitem" data-i18n="screen.account" set:html={t("screen.account")}></span>
            <span class="m-navitem m-navitem-on" data-i18n="screen.customisation" set:html={t("screen.customisation")}></span>
            <span class="m-navitem" data-i18n="screen.diagnostics" set:html={t("screen.diagnostics")}></span>
            <p class="m-saved" data-i18n="screen.saved-automatically" set:html={t("screen.saved-automatically")}></p>
          </nav>
          {/*
            Personalización as the app draws it today, in its Appearance part: the
            same three tabs, the same rows in the same cards, the shipped values
            (dark theme, the Ember accent, the Bone play button, 32%).
          */}
          <div class="m-sheet-body">
            <div class="m-sheet-top">
              <span class="m-settings-search">
                <Fragment set:html={icon("search", 15)} />
                <span data-i18n="screen.search-settings" set:html={t("screen.search-settings")}></span>
              </span>
              <span class="m-icbtn m-sheet-x"><Fragment set:html={icon("close", 17)} /></span>
            </div>
            <div class="m-tabs">
              <span class="m-tab m-tab-on" data-i18n="screen.appearance" set:html={t("screen.appearance")}></span>
              <span class="m-tab" data-i18n="screen.background" set:html={t("screen.background")}></span>
              <span class="m-tab" data-i18n="screen.effects" set:html={t("screen.effects")}></span>
              <span class="m-peek">
                <Fragment set:html={icon("eye", 15)} />
                <span data-i18n="screen.hold-to-preview" set:html={t("screen.hold-to-preview")}></span>
              </span>
            </div>
            <div class="m-cards">
              <div class="m-group">
                <div class="m-row">
                  <p class="m-row-t" data-i18n="screen.theme" set:html={t("screen.theme")}></p>
                  <span class="m-select">
                    <span data-i18n="screen.theme-dark" set:html={t("screen.theme-dark")}></span>
                    <Fragment set:html={icon("chevron", 14)} />
                  </span>
                </div>
              </div>
              <div class="m-group">
                <div class="m-row">
                  <div>
                    <p class="m-row-t" data-i18n="screen.main-colour" set:html={t("screen.main-colour")}></p>
                    <p class="m-row-d" data-i18n="screen.the-colour-that-marks-actions" set:html={t("screen.the-colour-that-marks-actions")}></p>
                  </div>
                  <span class="m-swatches">
                    {ACCENTS.map((hex, i) => (
                      <span class={`m-sw${i === 0 ? " m-sw-on" : ""}`} style={`background:${hex}`} />
                    ))}
                    <span class="m-sw m-sw-pick"><Fragment set:html={icon("pencil", 12)} /></span>
                  </span>
                </div>
                <div class="m-row">
                  <div>
                    <p class="m-row-t" data-i18n="screen.play-button" set:html={t("screen.play-button")}></p>
                    <p class="m-row-d" data-i18n="screen.play-button-bone-hint" set:html={t("screen.play-button-bone-hint")}></p>
                  </div>
                  <span class="m-swatches">
                    <span class="m-dress m-dress-bone m-sw-on"><Fragment set:html={iconFilled("play", 11)} /></span>
                    <span class="m-dress m-dress-accent"><Fragment set:html={iconFilled("play", 11)} /></span>
                    <span class="m-dress m-dress-cover"><Fragment set:html={iconFilled("play", 11)} /></span>
                    <span class="m-dress m-dress-glass"><Fragment set:html={iconFilled("play", 11)} /></span>
                  </span>
                </div>
              </div>
              <div class="m-group m-group-span">
                <div class="m-row">
                  <div class="m-row-text">
                    <p class="m-row-t" data-i18n="screen.surface-opacity" set:html={t("screen.surface-opacity")}></p>
                    <p class="m-row-d" data-i18n="screen.surface-opacity-hint" set:html={t("screen.surface-opacity-hint")}></p>
                  </div>
                  <span class="m-slider">
                    <span class="m-slider-n">32%</span>
                    <span class="m-slider-col">
                      <span class="m-slider-t"><span class="m-slider-k" /></span>
                      <span class="m-slider-ends">
                        <span data-i18n="screen.transparent" set:html={t("screen.transparent")}></span>
                        <span data-i18n="screen.solid" set:html={t("screen.solid")}></span>
                      </span>
                    </span>
                    <span class="m-legend" />
                  </span>
                </div>
              </div>
            </div>
            <div class="m-group m-group-reset">
              <div class="m-row">
                <div>
                  <p class="m-row-t" data-i18n="screen.reset-customisation" set:html={t("screen.reset-customisation")}></p>
                  <p class="m-row-d" data-i18n="screen.reset-customisation-hint" set:html={t("screen.reset-customisation-hint")}></p>
                </div>
                <span class="m-btn" data-i18n="screen.reset" set:html={t("screen.reset")}></span>
              </div>
            </div>
          </div>
        </div>
      </>
    )
  }

  {
    variant !== "settings" && (
      <div class="m-player">
        <div class="m-pl-left">
