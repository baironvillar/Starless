</div>

<script is:inline id="frag" type="x-shader/x-fragment">
precision highp float;
uniform vec2 uCenter;
uniform float uRadius;
uniform float uTime;
uniform float uEnergy;
uniform vec2 uMouse;
uniform float uPull;

// Nearest centre of a hexagonal lattice: ferrofluid under a magnet settles
// into exactly this pattern of spikes.
vec2 hexCentre(vec2 p) {
  vec2 r = vec2(1.0, 1.7320508);
  vec2 h = r * 0.5;
  vec2 a = mod(p, r) - h;
  vec2 b = mod(p - h, r) - h;
  return p - (dot(a, a) < dot(b, b) ? a : b);
}

float height(vec2 q) {
  float r = length(q);
  float dome = 0.16 * (1.0 - smoothstep(0.0, 1.0, r * r));
  vec2 c = hexCentre(q * 5.6) / 5.6;
  float d = length(q - c) * 5.6;
  // The spikes die out well before the rim, so the edge is a meniscus and
  // not a ring of half-risen cones. Both are read at the point, not at the
  // cell's centre: per-cell values jump at the cell edges and cut the pool
  // into hexagonal tiles.
  float fall = 1.0 - smoothstep(0.25, 0.74, r);
  // A second magnet under the cursor: the spikes near it stand up taller,
  // and its field reaches further towards the rim than the one underneath.
  vec2 m = q - uMouse;
  float near = uPull * exp(-dot(m, m) * 7.0);
  fall = max(fall, near * (1.0 - smoothstep(0.72, 0.9, r)));
  float wobble = 0.8 + 0.2 * sin(uTime * 2.6 + q.x * 11.0 + q.y * 7.0);
  // The footprint is wider than half the lattice spacing, so neighbouring
  // cones meet in saddles and there is no flat plate showing between them.
  float k = max(0.0, 1.0 - d / 0.58);
  float spike = min(uEnergy + near * 0.6, 1.5) * fall * wobble * k * k * (3.0 - 2.0 * k) * 0.9;
  return (dome + spike) * (1.0 - smoothstep(0.92, 1.0, r));
}

// The pool is seen at an angle, like a dish on a desk: the ground is
// foreshortened by FORE, and anything at height z shows LIFT * z higher on
// screen. Each pixel walks down its line of sight until it meets the liquid.
const float LIFT = 0.5;
const float FORE = 0.6;
const float ZTOP = 1.6;

vec2 ground(vec2 q, float z) { return vec2(q.x, (q.y - LIFT * z) / FORE); }

bool inside(vec2 g, float z) { return length(g) < 1.0 && height(g) >= z; }

vec3 floorAt(vec2 q) {
  vec2 g = ground(q, 0.0);
  float r = length(g);
  // Rings spreading out from the pool, each one further out than the last.
  float ring = 0.0;
  for (int i = 0; i < 4; i++) {
    float t = fract(uTime * 0.11 + float(i) * 0.25);
    float rr = 1.1 + t * 3.0;
    ring += exp(-abs(r - rr) * uRadius * 0.55) * (1.0 - t) * 0.09;
  }
  float shadow = exp(-max(r - 1.0, 0.0) * 4.0) * 0.7;
  return vec3(0.043, 0.043, 0.059) * (1.0 - shadow) + vec3(0.93, 0.92, 0.89) * ring;
}

void main() {
  vec2 q = (gl_FragCoord.xy - uCenter) / uRadius;

  // Only the heights where this line of sight is over the dish are worth
  // marching; everywhere else is floor, and that is most of the screen.
  float hit = -1.0;
  float span = 1.0 - q.x * q.x;
  if (span > 0.0) {
    span = sqrt(span);
    float zHi = min(ZTOP, (q.y + FORE * span) / LIFT);
    float zLo = max(0.0, (q.y - FORE * span) / LIFT);
    if (zHi > zLo) {
      float stepZ = (zHi - zLo) / 64.0;
      for (int i = 0; i <= 64; i++) {
        float z = zHi - float(i) * stepZ;
        if (inside(ground(q, z), z)) {
          float lo = z, hi = z + stepZ;
          for (int k = 0; k < 6; k++) {
            float mid = 0.5 * (lo + hi);
            if (inside(ground(q, mid), mid)) lo = mid; else hi = mid;
          }
          hit = lo;
          break;
        }
      }
    }
  }

  vec3 col;
  if (hit < 0.0) {
    col = floorAt(q);
  } else {
    vec2 g = ground(q, hit);
    float e = 0.003;
    float h = height(g);
    vec3 n = normalize(vec3(-(height(g + vec2(e, 0.0)) - h) / e, -(height(g + vec2(0.0, e)) - h) / e, 1.0));
    vec3 v = normalize(vec3(0.0, -0.85, 0.55));
    vec3 R = reflect(-v, n);
    vec3 key = normalize(vec3(-0.35, 0.45, 0.82));
    vec3 rim = normalize(vec3(0.75, 0.1, 0.35));
    // Black liquid only shows the lights it faces. The broad sheen belongs to
    // the flanks: on the flat between the spikes it turned the pool into a plate.
    float flank = smoothstep(0.08, 0.35, 1.0 - n.z);
    float spec = pow(max(dot(R, key), 0.0), 80.0) * 2.2 * mix(0.2, 1.0, flank);
    float soft = pow(max(dot(R, key), 0.0), 8.0) * 0.16 * flank;
    float cool = pow(max(dot(R, rim), 0.0), 18.0) * 0.5;
    float fres = pow(1.0 - max(dot(n, v), 0.0), 4.0) * 0.35 * flank;
    // Two softboxes, a tall one at the key's side and a wide one overhead:
    // the thin bright strips on each flank are what makes it read as ferrofluid.
    float tall = smoothstep(0.05, 0.0, abs(R.x + 0.42)) * smoothstep(0.15, 0.45, R.z) * smoothstep(-0.2, 0.3, R.y);
    float wide = smoothstep(0.04, 0.0, abs(R.y - 0.6)) * smoothstep(0.2, 0.5, R.z) * smoothstep(0.7, 0.2, abs(R.x));
    float strips = (tall * 0.55 + wide * 0.35) * flank;
    col = vec3(0.008, 0.009, 0.011)
        + vec3(0.96, 0.97, 1.0) * (spec + soft + fres)
        + vec3(0.9, 0.92, 0.96) * strips
        + vec3(0.6, 0.59, 0.63) * cool;
  }
  gl_FragColor = vec4(col, 1.0);
}
</script>
<script is:inline id="drop" type="x-shader/x-fragment">
precision highp float;
uniform float uSize;
uniform float uTime;
uniform float uEnergy;

vec2 hexCentre(vec2 p) {
  vec2 r = vec2(1.0, 1.7320508);
  vec2 h = r * 0.5;
  vec2 a = mod(p, r) - h;
  vec2 b = mod(p - h, r) - h;
  return p - (dot(a, a) < dot(b, b) ? a : b);
}

// The same liquid as the pool, as one drop seen from just above: a bead
// with a handful of spikes that rise on the same beat.
float height(vec2 q) {
  float r = length(q);
  float bead = sqrt(max(0.0, 1.0 - r * r)) * 0.55;
  vec2 c = hexCentre(q * 2.0) / 2.0;
  float d = length(q - c) * 2.0;
  float k = max(0.0, 1.0 - d / 0.58);
  float fall = 1.0 - smoothstep(0.2, 0.8, r);
  float wobble = 0.8 + 0.2 * sin(uTime * 2.6 + q.x * 5.0 + q.y * 3.0);
  return bead + uEnergy * fall * wobble * k * k * (3.0 - 2.0 * k) * 0.8;
}

void main() {
  vec2 q = (gl_FragCoord.xy / uSize) * 2.0 - 1.0;
  q *= 1.06;
  float r = length(q);
  float cover = smoothstep(1.0, 0.95, r);
  if (cover <= 0.0) { gl_FragColor = vec4(0.0); return; }
  float e = 0.004;
  float h = height(q);
  vec3 n = normalize(vec3(-(height(q + vec2(e, 0.0)) - h) / e, -(height(q + vec2(0.0, e)) - h) / e, 1.0));
  vec3 v = normalize(vec3(0.0, -0.35, 0.94));
  vec3 R = reflect(-v, n);
  vec3 key = normalize(vec3(-0.35, 0.45, 0.82));
  vec3 rim = normalize(vec3(0.75, 0.1, 0.35));
  float spec = pow(max(dot(R, key), 0.0), 40.0) * 2.4;
  float soft = pow(max(dot(R, key), 0.0), 10.0) * 0.45;
  float cool = pow(max(dot(R, rim), 0.0), 14.0) * 0.45;
  float fres = pow(1.0 - max(dot(n, v), 0.0), 3.0) * 0.5;
  vec3 col = vec3(0.008, 0.009, 0.011)
      + vec3(0.96, 0.97, 1.0) * (spec + soft + fres)
      + vec3(0.6, 0.59, 0.63) * cool;
  gl_FragColor = vec4(col * cover, cover);
}
</script>
<script is:inline>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const NS = "http://www.w3.org/2000/svg";
  const canvas = document.getElementById("ferro");
  const hero = document.getElementById("inicio");
  const dot = document.getElementById("dot");
  const progress = document.getElementById("progress");
  const line = document.querySelector(".line");
  const keys = [...document.querySelectorAll(".key")];
  const djMark = document.querySelector(".dj-mark");

  const phone = () => innerWidth <= 860;
  // Where the pool sits, as fractions of the hero: right of the words on a
  // desk screen, above them on a phone. The shader uses it.
  const stage = document.querySelector(".stage");
  // In CSS pixels from the hero's top left. On a phone the pool fills its
  // band: the spikes rise about 0.9 radii above the centre and the dish
  // reaches 0.6 below, so the centre sits a little under the middle.
  const pool = () => {
    const w = hero.offsetWidth, h = hero.offsetHeight;
    if (!phone()) return { x: w * 0.66, y: h * 0.5, r: Math.min(w * 0.32, h * 0.5) };
    const r = Math.min(w * 0.42, stage.offsetHeight / 1.6);
    return { x: w * 0.5, y: stage.offsetTop + stage.offsetHeight * 0.58, r };
  };

  // The beat the pool keeps when nothing else is happening, and how much the
  // scroll and the download key add on top of it.
  const BPM = 112;
  let energy = 0.55, scrollBoost = 0, keyBoost = 0, keyWant = 0, lastY = scrollY, heroVisible = true;
  const start = performance.now();

  // The cursor is a magnet held over the dish. Its place is kept in the
  // pool's own ground coordinates, eased so the liquid follows rather than
  // snaps; it lets go when the pointer leaves the dish.
  const magnet = { x: 0, y: 0, pull: 0, wantX: 0, wantY: 0, want: 0 };
  addEventListener("pointermove", (e) => {
    if (!heroVisible) return;
    const box = hero.getBoundingClientRect();
    const p = pool();
    const qx = (e.clientX - box.left - p.x) / p.r;
    const qy = (p.y - (e.clientY - box.top)) / p.r;
    // The pointer is over a spike's body, which shows above its foot: step
    // down to the ground it stands on (FORE and LIFT, as in the shader).
    magnet.wantX = qx;
    magnet.wantY = (qy - 0.2) / 0.6;
    magnet.want = Math.hypot(magnet.wantX, magnet.wantY) < 1.25 ? 1 : 0;
  }, { passive: true });
  document.addEventListener("pointerleave", () => { magnet.want = 0; });

  const gl = canvas.getContext("webgl", { antialias: true, premultipliedAlpha: false });
  let draw = () => {};
  if (gl) {
    const vs = gl.createShader(gl.VERTEX_SHADER);
    gl.shaderSource(vs, "attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }");
    gl.compileShader(vs);
    const fs = gl.createShader(gl.FRAGMENT_SHADER);
    gl.shaderSource(fs, document.getElementById("frag").textContent);
    gl.compileShader(fs);
    const prog = gl.createProgram();
    gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog); gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, "p");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const u = (n) => gl.getUniformLocation(prog, n);
    const uCenter = u("uCenter"), uRadius = u("uRadius"), uTime = u("uTime"), uEnergy = u("uEnergy");
    const uMouse = u("uMouse"), uPull = u("uPull");

    // One pixel per CSS pixel: a landing for a light player must not spin the fan.
    function size() {
      canvas.width = canvas.clientWidth;
      canvas.height = canvas.clientHeight;
      gl.viewport(0, 0, canvas.width, canvas.height);
    }
    size();
    // The hero grows when the fonts land, not only when the window resizes.
    new ResizeObserver(size).observe(canvas);

    draw = (t) => {
      const p = pool();
      // gl_FragCoord starts at the bottom, so the pool's y is flipped.
      gl.uniform2f(uCenter, p.x, canvas.height - p.y);
      gl.uniform1f(uRadius, p.r);
      gl.uniform1f(uTime, t);
      gl.uniform1f(uEnergy, energy);
      gl.uniform2f(uMouse, magnet.x, magnet.y);
      gl.uniform1f(uPull, magnet.pull);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    };
  } else {
    canvas.style.background = "radial-gradient(circle at 66% 50%, #15151b 0 22%, transparent 22.3%)";
  }

  // The player's art is a drop of the same liquid, so the bar keeps the beat
  // after the pool has scrolled away. Its own tiny context: 84 pixels square.
  let drawDrop = () => {};
  const dgl = dot.getContext("webgl", { antialias: true, premultipliedAlpha: true, alpha: true });
  if (dgl) {
    const sh = (type, src) => { const x = dgl.createShader(type); dgl.shaderSource(x, src); dgl.compileShader(x); return x; };
    const prog = dgl.createProgram();
    dgl.attachShader(prog, sh(dgl.VERTEX_SHADER, "attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }"));
    dgl.attachShader(prog, sh(dgl.FRAGMENT_SHADER, document.getElementById("drop").textContent));
    dgl.linkProgram(prog); dgl.useProgram(prog);
    dgl.bindBuffer(dgl.ARRAY_BUFFER, dgl.createBuffer());
    dgl.bufferData(dgl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), dgl.STATIC_DRAW);
    const loc = dgl.getAttribLocation(prog, "p");
    dgl.enableVertexAttribArray(loc);
    dgl.vertexAttribPointer(loc, 2, dgl.FLOAT, false, 0, 0);
    const uSize = dgl.getUniformLocation(prog, "uSize"), uT = dgl.getUniformLocation(prog, "uTime"), uE = dgl.getUniformLocation(prog, "uEnergy");
    dgl.viewport(0, 0, dot.width, dot.height);
    drawDrop = (t) => {
      dgl.uniform1f(uSize, dot.width);
      dgl.uniform1f(uT, t);
      dgl.uniform1f(uE, energy);
      dgl.clearColor(0, 0, 0, 0);
      dgl.clear(dgl.COLOR_BUFFER_BIT);
      dgl.drawArrays(dgl.TRIANGLE_STRIP, 0, 4);
    };
  }

  // There is nothing between the sections. The rings that used to be here
  // were the family of concentric curves that divided the page, and a page
  // whose sections are divided by curves reads as a diagram of itself: they
  // were decoration pretending to be structure. The dot that replaced them
  // was the same idea in miniature — a mark saying where you are, laid over
  // the content. What separates the sections now is the content and the
  // hairlines between its rows, and where you are is said by the player bar,
  // which names the section. Nothing else is needed and nothing else is drawn.

  for (const k of keys) {
    const on = () => { keyWant = 0.35; };
    const off = () => { keyWant = 0; k.style.setProperty("--mx", "50%"); };
    // The light under the glass follows the hand across the key.
    k.addEventListener("pointermove", (e) => {
      const b = k.getBoundingClientRect();
      k.style.setProperty("--mx", `${(((e.clientX - b.left) / b.width) * 100).toFixed(1)}%`);
    });
    k.addEventListener("pointerenter", on);
    k.addEventListener("focus", on);
    k.addEventListener("pointerleave", off);
    k.addEventListener("blur", off);
  }

  new IntersectionObserver(([e]) => { heroVisible = e.isIntersecting; }).observe(hero);

  const setProgress = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    progress.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
  };

  let last = performance.now();
  function frame(now) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    const t = (now - start) / 1000;
    const y = scrollY;
    const v = Math.abs(y - lastY) / Math.max(dt, 0.001);
    lastY = y;
    setProgress();

    // A kick on every beat that decays fast, like a woofer; the scroll's
    // speed and the hand on the download key feed in and drain away smoothly.
    const beat = (t * BPM) / 60;
    const kick = Math.exp(-(beat % 1) * 5);
    const ease = 1 - Math.exp(-dt * 6);
    scrollBoost += (Math.min(v / 2500, 0.6) - scrollBoost) * ease;
    keyBoost += (keyWant - keyBoost) * ease;
    energy = 0.42 + 0.38 * kick + scrollBoost + keyBoost;
    // The magnet slides a little slower than it grips, so a quick pass over
    // the dish leaves a wake instead of a jump.
    const glide = 1 - Math.exp(-dt * 9);
    magnet.x += (magnet.wantX - magnet.x) * glide;
    magnet.y += (magnet.wantY - magnet.y) * glide;
    magnet.pull += (magnet.want - magnet.pull) * (1 - Math.exp(-dt * 4));
    drawDrop(t);
    // The DJ's ring keeps the same beat as the pool and the bar.
    djMark.style.scale = String(1 + 0.03 * kick);
    // And so does the ember under the download keys.
    for (const k of keys) k.style.setProperty("--beat", kick.toFixed(3));

    if (heroVisible) draw(t);
    requestAnimationFrame(frame);
  }
  if (reduce) {
    energy = 0.7;
    draw(1.2);
    drawDrop(1.2);
    setProgress();
    addEventListener("scroll", setProgress, { passive: true });
  } else {
    requestAnimationFrame(frame);
  }

  // The DJ's line, a word at a time across the part of the section that
  // holds still, the way the app shows the phrase while the voice says it.
  const djLine = document.getElementById("dj-line");
  // Both languages live in the markup: English is the text, Spanish rides in
  // data-es. The English is kept before anything rewrites it, the DJ's line included.
  const translated = [...document.querySelectorAll("[data-es]")];
  for (const n of translated) n.dataset.en = n.innerHTML;
  const labelled = [...document.querySelectorAll("[data-es-label]")];
  for (const n of labelled) n.dataset.enLabel = n.getAttribute("aria-label");
  const sections = [...document.querySelectorAll("[data-track]")];
  for (const s of sections) s.dataset.trackEn = s.dataset.track;

  function splitDj() {
    const words = djLine.textContent.trim().split(/\s+/);
    djLine.replaceChildren(
      ...words.flatMap((w, i) => {
        const s = document.createElement("span");
        s.className = "w";
        s.textContent = w;
        const a = 20 + (i / words.length) * 60;
        s.style.animationRange = `contain ${a.toFixed(1)}% contain ${(a + 5).toFixed(1)}%`;
        return i ? [" ", s] : [s];
      }),
    );
  }
  splitDj();

  // The crossfade: bars for two songs on one 30-second axis, crossing at
  // the middle on the same equal-power curve the app uses. The heights are
  // fixed noise, so moving the slider only reshapes the meeting.
  const mix = document.getElementById("mix");
  const xfade = document.getElementById("xfade");
  const xfadeOut = document.getElementById("xfade-out");
  const BARS = 120, SPAN = 30, MID = 100;
  const noise = (i, seed) => {
    const v = Math.sin(i * 12.9898 + seed * 78.233) * 43758.5453;
    return 0.35 + 0.65 * (v - Math.floor(v)) * (0.75 + 0.25 * Math.sin(i * 0.21 + seed));
  };
  const zone = document.createElementNS(NS, "rect");
  zone.setAttribute("class", "zone");
  zone.setAttribute("y", "0");
  zone.setAttribute("height", "200");
  const bars = [];
  mix.append(zone);
  for (let i = 0; i < BARS; i++) {
    for (const side of ["a", "b"]) {
      const r = document.createElementNS(NS, "rect");
      r.setAttribute("class", side);
      r.setAttribute("x", ((i / BARS) * 1000 + 1.5).toFixed(1));
      r.setAttribute("width", (1000 / BARS - 3).toFixed(1));
      mix.append(r);
      bars.push({ r, i, side });
    }
  }
  function drawMix() {
    const d = +xfade.value;
    xfadeOut.textContent = `${d} s`;
    const from = SPAN / 2 - d / 2, to = SPAN / 2 + d / 2;
    zone.style.x = `${(from / SPAN) * 1000}px`;
    zone.style.width = `${(d / SPAN) * 1000}px`;
    for (const { r, i, side } of bars) {
      const t = ((i + 0.5) / BARS) * SPAN;
      // With no crossing, one stops where the other starts.
      const x = d ? Math.min(Math.max((t - from) / d, 0), 1) : t < SPAN / 2 ? 0 : 1;
      const gain = side === "a" ? Math.cos((x * Math.PI) / 2) : Math.sin((x * Math.PI) / 2);
      const h = gain * noise(i, side === "a" ? 1 : 2) * (MID - 6);
      r.style.y = `${side === "a" ? MID - 1 - h : MID + 1}px`;
      r.style.height = `${h}px`;
    }
  }
  xfade.addEventListener("input", drawMix);
  drawMix();

  // The download keys hand over the installer itself, not the releases page.
  // The MSI is named after its version, so there is no fixed link to the
  // newest one: the page ships pointing at the one it was written with, and
  // asks GitHub which release is the public one now. `releases/latest` never
  // answers with a prerelease or a draft, so a develop build can't land here.
  // If the question fails (offline, rate limit) the written link still works.
  // The size is the one written with the page until GitHub says otherwise.
  let lang = "en", bytes = 8474624;
  // MiB, because that is the number Windows shows next to the downloaded file.
  const paint = () => {
    const mb = new Intl.NumberFormat(lang, { maximumFractionDigits: 1 }).format(bytes / 1048576);
    for (const s of document.querySelectorAll("[data-size]")) s.textContent = `${mb} MB`;
  };
  fetch("https://api.github.com/repos/baironvillar/Starless/releases/latest")
    .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
    .then((release) => {
      const msi = release.assets.find((a) => a.name.endsWith(".msi"));
      if (!msi) return;
      for (const k of document.querySelectorAll("[data-msi]")) k.href = msi.browser_download_url;
      bytes = msi.size;
      paint();
    })
    .catch(() => {});

  let current = hero;
  // The title that is on screen, and the one that is on its way out. Two
  // rolls in flight at once put the two texts on top of each other, and a
  // fast scroll crosses two sections at a time.
  let currentSpan = line.querySelector("span");
  function show(section) {
    const text = section.dataset.track;
    if (section === current) return;
    current = section;
    if (reduce) { currentSpan.textContent = text; return; }
    // A roll is still arriving: the title changes under it instead of
    // starting a second one.
    if (currentSpan.classList.contains("in")) { currentSpan.textContent = text; return; }
    const old = currentSpan;
    const next = document.createElement("span");
    next.textContent = text;
    next.className = "in";
    line.appendChild(next);
    currentSpan = next;
    // The new title has to be painted in its "in" state before it is told
    // to come in, or there is nothing to transition from and it lands on
    // top of the old one.
    void next.offsetWidth;
    old.classList.add("out");
    next.classList.remove("in");
    setTimeout(() => old.remove(), 460);
  }
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) show(e.target);
  }, { rootMargin: "-45% 0px -50% 0px" });
  sections.forEach((s) => io.observe(s));

  function apply(next) {
    lang = next;
    document.documentElement.lang = next;
    for (const n of translated) n.innerHTML = next === "es" ? n.dataset.es : n.dataset.en;
    for (const n of labelled) n.setAttribute("aria-label", next === "es" ? n.dataset.esLabel : n.dataset.enLabel);
    for (const s of sections) s.dataset.track = next === "es" ? s.dataset.trackEs : s.dataset.trackEn;
    splitDj();
    paint();
    currentSpan.textContent = current.dataset.track;
  }

  // Two quick clicks land on the last language asked for, in one swap.
  let want = "en", timer = 0;
  function setLang(next) {
    want = next;
    try { localStorage.setItem("starless-lang", next); } catch {}
    if (reduce) return apply(next);
    if (timer) return;
    document.documentElement.classList.add("swapping");
    timer = setTimeout(() => {
      timer = 0;
      apply(want);
      document.documentElement.classList.remove("swapping");
    }, 180);
  }
  document.querySelector(".lang").addEventListener("click", () => setLang(want === "en" ? "es" : "en"));
  try { if (localStorage.getItem("starless-lang") === "es") { want = "es"; apply("es"); } } catch {}
</script>
</body>
</html>
