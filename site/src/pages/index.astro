---
import { Font } from "astro:assets";
import Screen from "../components/Screen.astro";

// Link previews need absolute URLs: a chat app fetches the image from its own servers.
const home = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/`, Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Starless</title>
<meta name="description" content="A light, unofficial desktop client for your Premium account. For Windows." />
<link rel="canonical" href={home} />
<meta property="og:type" content="website" />
<meta property="og:url" content={home} />
<meta property="og:title" content="Starless" />
<meta property="og:description" content="A light, unofficial desktop client for your Premium account. For Windows." />
<meta property="og:image" content={`${home}starless.png`} />
<meta property="og:locale" content="en_GB" />
<meta property="og:locale:alternate" content="es_ES" />
<!-- shortcut: a square icon card, not a 1200×630 banner; draw one if previews should show the app. -->
<meta name="twitter:card" content="summary" />
<!-- The files in public/ are served at the root of the site, and Astro asks
     for their URLs to carry the base. A relative path only finds them when
     the URL ends with a slash: without it the logo and the screenshots come
     out broken while the text and the styles load fine. -->
<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/starless.svg`} />
<Font cssVariable="--font-syne" preload />
<Font cssVariable="--font-dm-sans" preload />
<Font cssVariable="--font-dm-mono" />
<style is:global>
  :root {
    /* "A night without stars": brand-kit/tokens.css, shared with the app. */
    --ground: #0b0b0f;   /* Void */
    --night: #15151b;    /* Night: surfaces */
    --eclipse: #24242c;  /* Eclipse: tracks */
    --chrome: #c4c1c8;   /* the second song in the crossfade */
    --frost: #edeae3;    /* Bone: primary text, the logo */
    --body: #c4c1c8;     /* running text */
    --mute: #9a97a0;     /* Smoke */
    --ember: #ff5a36;    /* the one warm light; UI only, never the mark */
    --line: rgb(237 234 227 / 0.1);
    --sl-glass-fill: rgba(255, 255, 255, 0.06);
    --sl-glass-border: rgba(255, 255, 255, 0.16);
    --sl-glass-highlight: inset 0 1px 0 rgba(255, 255, 255, 0.3);
    --sl-glass-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
    --sl-glass-blur: blur(24px) saturate(140%);
    --font-display: var(--font-syne);
    --font-body: var(--font-dm-sans);
    --font-mono: var(--font-dm-mono);
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --gutter: clamp(20px, 4vw, 56px);
    color-scheme: dark;
  }
  * { box-sizing: border-box; margin: 0; }
  ::selection { background: var(--frost); color: var(--ground); }
  :focus-visible { outline: 2px solid var(--frost); outline-offset: 3px; border-radius: 4px; }
  html { scrollbar-color: var(--eclipse) var(--ground); }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  html, body { overflow-x: clip; }
  body { position: relative; background: var(--ground); color: var(--frost); font-family: var(--font-body); -webkit-font-smoothing: antialiased; }
  p { text-wrap: pretty; }
  h1, h2, h3 { text-wrap: balance; font-family: var(--font-display); font-weight: 700; letter-spacing: -0.02em; }
  a { color: inherit; }
  /* The grey tap flash on mobile browsers; the key answers a press with its own scale. */
  a, input { -webkit-tap-highlight-color: transparent; }
  .nums { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  /* Liquid glass and the silver wordmark, as in brand-kit/tokens.css. */
  .sl-glass { background: var(--sl-glass-fill); border: 1px solid var(--sl-glass-border); box-shadow: var(--sl-glass-highlight), var(--sl-glass-shadow); backdrop-filter: var(--sl-glass-blur); -webkit-backdrop-filter: var(--sl-glass-blur); }
  .sl-wordmark { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.03em; background: linear-gradient(180deg, #ffffff 0%, #dad7dd 55%, #8c8992 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .wrap { width: min(1200px, calc(100% - 2 * var(--gutter))); margin: 0 auto; }

  /* The download key: Ember under frosted glass. A warm light sits low behind
     the glass, diffused by it and breathing with the pool's kick (--beat); the
     hand pulls it up and across (--mx), and a specular line crosses the face
     as it arrives. The glass is the logo's material; the light is the one
     warm thing the brand allows. */
  .key { --mx: 50%; --beat: 0; position: relative; isolation: isolate; display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; color: var(--frost); text-decoration: none; font-weight: 600; font-size: 15px; padding: 15px 24px; border-radius: 999px; background: linear-gradient(180deg, rgb(255 255 255 / 0.14), rgb(255 255 255 / 0.04)); border: 1px solid rgb(255 255 255 / 0.18); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.4), inset 0 -8px 18px rgb(255 90 54 / 0.08), 0 14px 34px rgb(0 0 0 / 0.5); backdrop-filter: blur(16px) saturate(160%); -webkit-backdrop-filter: blur(16px) saturate(160%); transition: transform 160ms var(--ease-out), border-color 320ms var(--ease-out); }
  .key::before { content: ""; position: absolute; inset: -10px -6px; z-index: -1; border-radius: inherit; pointer-events: none; background: radial-gradient(70% 140% at var(--mx) 100%, rgb(255 90 54 / 0.9), rgb(255 90 54 / 0.35) 40%, transparent 70%); filter: blur(10px); opacity: calc(0.45 + var(--beat) * 0.3); transform: translateY(6px) scaleX(0.8); transition: opacity 320ms var(--ease-out), transform 420ms var(--ease-out); }
  .key::after { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: linear-gradient(105deg, transparent 38%, rgb(255 255 255 / 0.28) 50%, transparent 62%) 130% 0 / 260% 100% no-repeat; transition: background-position 800ms var(--ease-out); }
  .key:focus-visible { border-color: rgb(255 180 160 / 0.35); }
  .key:focus-visible::before { opacity: calc(0.85 + var(--beat) * 0.15); transform: translateY(-2px) scale(1.05); }
  .key:focus-visible::after { background-position: -30% 0; }
  .key:active { transform: scale(0.97); }
  .key .size { color: var(--mute); font-weight: 400; font-size: 13px; }
  .key svg { width: 17px; height: 17px; flex: none; transition: transform 320ms var(--ease-out); }
  /* A tap is a hover that never ends on a phone: the ember stayed raised
     after the download started. Only a real pointer lights it. */
  @media (hover: hover) and (pointer: fine) {
    .key:hover { border-color: rgb(255 180 160 / 0.35); }
    .key:hover::before { opacity: calc(0.85 + var(--beat) * 0.15); transform: translateY(-2px) scale(1.05); }
    .key:hover::after { background-position: -30% 0; }
    .key:hover svg { transform: translateY(2px); }
    .top a:hover { color: var(--frost); }
    .tracks li:hover { background: rgb(237 234 227 / 0.04); }
  }
  @media (prefers-reduced-motion: reduce) { .key::before, .key::after, .key svg { transition: none; } }

  /* Nothing divides the sections. The rings that used to live here were the
     family of concentric curves that separated them, and a page whose
     sections are separated by curves reads as a diagram of itself: they were
     decoration pretending to be structure. The dot that replaced them was the
     same idea in miniature — a mark saying where you are, laid over the
     content. What separates the sections now is the content and the
     hairlines between its rows, and where you are is said by the player bar,
     which names the section. Nothing else is needed and nothing else is
     drawn. */

  /* The pool */
  .hero { position: relative; z-index: 1; min-height: 100svh; display: grid; grid-template-rows: auto 1fr; overflow: hidden; }
  .stage { display: none; }
  #ferro { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .top { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 26px var(--gutter); font-size: 14px; color: var(--mute); }
  .top nav { display: flex; gap: 26px; }
  .top a { text-decoration: none; transition: color 200ms; }
  .brand { display: inline-flex; align-items: center; gap: 10px; }
  .brand img { width: 28px; height: 28px; }
  .brand .sl-wordmark { font-size: 22px; line-height: 1; }
  /* The version number read as noise next to the name; what a visitor needs to know is that the app is still a beta. */
  .beta { padding: 3px 8px; border: 1px solid var(--sl-glass-border); border-radius: 999px; font: 500 11px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute); }
  /* The language: both names, the one being read in frost. */
  .lang { display: inline-flex; gap: 6px; padding: 4px 0; border: 0; background: none; color: var(--mute); font: 500 13px var(--font-mono); cursor: pointer; transition: transform 160ms var(--ease-out); }
  .lang span { transition: color 200ms ease; }
  .lang span + span::before { content: "/"; margin-right: 6px; color: var(--eclipse); }
  .lang:active { transform: scale(0.95); }
  html[lang="en"] .lang [lang="en"], html[lang="es"] .lang [lang="es"] { color: var(--frost); }

  /* Changing the language rewrites every word on the page at once. The words
     dissolve and come back instead of snapping: out fast, in a little slower.
     It is a filter and not opacity because the scroll timelines already own
     the opacity of half these elements, and an animation beats a declaration. */
  [data-es], .line { transition: filter 280ms var(--ease-out); }
  .swapping :is([data-es], .line) { filter: blur(4px) opacity(0); transition-duration: 180ms; }
  .pitch { position: relative; z-index: 2; align-self: center; padding: 0 var(--gutter) 120px; max-width: 34rem; }
  /* The mark on its glass plate, like the app icon: the hero is the logo. */
  .plate { width: clamp(112px, 11vw, 168px); aspect-ratio: 1; border-radius: 22.5%; display: grid; place-items: center; margin-bottom: 30px; }
  .plate img { width: 76%; height: 76%; }
  /* As wide as the word, not as the column: at 112px "starless" ran 10px past the 34rem column, and the silver gradient (background-clip: text) paints only inside the box, so the last "s" was cut off. The padding is the wordmark's -0.03em tracking, which is also taken after the last letter and pulls the box in past its ink. */
  .pitch h1 { width: max-content; padding-right: 0.04em; font-size: clamp(64px, 7.4vw, 112px); line-height: 0.95; padding-bottom: 0.06em; }
  .pitch p { margin-top: 22px; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.55; color: var(--body); max-width: 26rem; }
  .pitch .key { margin-top: 30px; }
  .pitch .fine { margin-top: 14px; font-size: 13px; color: var(--mute); }

  section.ring { position: relative; padding: clamp(96px, 14vh, 160px) 0; }
  .ring h2 { font-size: clamp(36px, 4.6vw, 72px); line-height: 1; }
  .lede { margin-top: 18px; font-size: 18px; line-height: 1.6; color: var(--body); max-width: 34rem; }

  .promises { margin-top: 56px; }
  .promise { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 40px; padding: 30px 0; border-top: 1px solid var(--line); }
  .promise:last-child { border-bottom: 1px solid var(--line); }
  .promise h3 { font-size: clamp(24px, 2.4vw, 34px); line-height: 1.1; }
  .promise p { font-size: 17px; line-height: 1.65; color: var(--body); }

  /* The screens: one window with its pictures stacked, and the list of what
     each one is. Without scroll timelines only the first picture shows.
     The pictures are drawings of the app and not photographs of an account:
     the names are bars and the covers are gradients, because `public/` is
     published and a photograph of somebody's library is a disclosure. The
     container lets each drawing measure itself against the window it is in. */
  .shots { margin-top: 48px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr); gap: 48px; align-items: center; }
  .steps { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .steps li { padding: 18px 0; border-bottom: 1px solid var(--line); }
  .steps h3 { font-size: 21px; }
  .steps p { margin-top: 6px; color: var(--body); font-size: 15px; line-height: 1.55; }
  .window { position: relative; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: var(--night); box-shadow: 0 0 0 1px var(--line), 0 30px 80px rgb(0 0 0 / 0.5); }
  .shot { position: absolute; inset: 0; display: grid; place-items: center; color: var(--mute); font-size: 13px; background: var(--night); container-type: inline-size; }
  .shot + .shot { opacity: 0; }

  /* The DJ: its ring, in ink like the app's own button, and what it says. */
  .dj { margin-top: 48px; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .dj-mark { width: clamp(140px, 20vw, 260px); height: auto; color: var(--frost); }
  .dj-mark circle { fill: none; stroke: currentColor; stroke-width: 13; stroke-linecap: round; stroke-dasharray: 212 27; stroke-dashoffset: 166; }
  .dj-who { font-size: 13px; color: var(--mute); }
  .dj-line { margin-top: 14px; font-family: var(--font-display); font-weight: 600; font-size: clamp(24px, 2.6vw, 38px); line-height: 1.25; letter-spacing: -0.015em; max-width: 30ch; }
  .dj-next { margin-top: 22px; font-size: 15px; color: var(--body); }

  /* What it doesn't do: each one is crossed out on the page. */
  .nots { list-style: none; padding: 0; margin-top: 48px; border-top: 1px solid var(--line); }
  .nots li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 40px; padding: 26px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .nots h3 { font-size: clamp(22px, 2.2vw, 30px); line-height: 1.2; color: var(--mute); }
  /* A hard-edged line, not a gradient for looks: it is the strike itself, and
     drawn as a background it can grow from the left across a wrapped title. */
  .nots h3 span { background: linear-gradient(var(--frost), var(--frost)) 0 58% / 100% 2px no-repeat; }
  .nots p { font-size: 16px; line-height: 1.6; color: var(--body); }

  /* The crossfade: two songs on one axis, the ending one above, the next one
     below, and the overlap the slider sets. */
  .mix { margin-top: 48px; }
  .mix-wave { position: relative; padding: 28px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .mix-wave svg { display: block; width: 100%; height: clamp(150px, 20vw, 230px); }
  .mix-wave rect { transition: y 360ms var(--ease-out), height 360ms var(--ease-out); }
  .mix-wave .a { fill: var(--frost); }
  .mix-wave .b { fill: var(--chrome); opacity: 0.55; }
  .mix-wave .zone { fill: rgb(237 234 227 / 0.05); transition: x 360ms var(--ease-out), width 360ms var(--ease-out); }
  .mix-a, .mix-b { position: absolute; font-size: 13px; color: var(--mute); }
  .mix-a { top: 6px; left: 0; }
  .mix-b { bottom: 6px; right: 0; }
  .playhead { position: absolute; top: 28px; bottom: 28px; left: 0; width: 1px; background: rgb(237 234 227 / 0.7); display: none; }
  .mix-ctl { margin-top: 24px; display: flex; gap: 18px; align-items: center; font-size: 14px; color: var(--mute); }
  .mix-ctl input { flex: 1; max-width: 360px; height: 24px; margin: 0; appearance: none; background: none; cursor: pointer; }
  .mix-ctl input::-webkit-slider-runnable-track { height: 2px; background: var(--eclipse); border-radius: 2px; }
  .mix-ctl input::-webkit-slider-thumb { appearance: none; width: 16px; height: 16px; margin-top: -7px; border-radius: 50%; background: var(--frost); transition: scale 160ms var(--ease-out); }
  .mix-ctl input:active::-webkit-slider-thumb { scale: 1.2; }
  .mix-ctl input::-moz-range-track { height: 2px; background: var(--eclipse); border-radius: 2px; }
  .mix-ctl input::-moz-range-thumb { width: 16px; height: 16px; border: 0; border-radius: 50%; background: var(--frost); }
  .mix-ctl output { min-width: 4ch; color: var(--frost); font-weight: 600; }

  .caption { margin-top: 14px; font-size: 13px; color: var(--mute); }

  .tracks { list-style: none; padding: 0; margin-top: 48px; border-top: 1px solid var(--line); }
  .tracks li { display: grid; grid-template-columns: 40px minmax(0, 1fr) minmax(0, 1.2fr) 90px; gap: 20px; align-items: baseline; padding: 20px 8px; border-bottom: 1px solid var(--line); transition: background-color 200ms ease; }
  .tracks .n { color: var(--mute); font-size: 14px; text-align: right; }
  .tracks h3 { font-size: 21px; }
  .tracks p { color: var(--body); font-size: 16px; line-height: 1.55; }
  .tracks .v { text-align: right; color: var(--mute); font-size: 13px; }
  .tracks .soon { color: var(--frost); }
  /* The meter only exists where the scroll can light it. */
  .eq { display: none; }

  .before { margin-top: 48px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; }
  .lead { align-self: start; padding-top: 20px; border-top: 1px solid rgb(237 234 227 / 0.45); }
  .lead h3 { font-size: 26px; }
  .lead p, .lead ol { margin-top: 10px; font-size: 16px; line-height: 1.65; color: var(--body); }
  .lead ol { padding-left: 20px; }
  .lead b { color: var(--frost); font-weight: 600; }
  .fact { padding: 20px 0; border-top: 1px solid var(--line); }
  .fact:last-child { border-bottom: 1px solid var(--line); }
  .fact h3 { font-size: 19px; }
  .fact p { margin-top: 6px; font-size: 16px; line-height: 1.6; color: var(--body); }

  footer { position: relative; padding: 72px var(--gutter) 150px; display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; font-size: 14px; color: var(--mute); }

  /* The player */
  .player { position: fixed; z-index: 10; left: 50%; bottom: 16px; translate: -50% 0; width: min(760px, calc(100% - 24px)); border-radius: 18px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 10px 10px 10px 12px; }
  /* Glass over the page, with a Night base under it so the title stays legible over running text. */
  .player.sl-glass { background: rgb(21 21 27 / 0.62); }
  .dot { width: 42px; height: 42px; display: block; }
  .now { min-width: 0; }
  .line { position: relative; height: 20px; overflow: hidden; }
  .line span { position: absolute; inset: 0; font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: transform 420ms var(--ease-out), opacity 420ms var(--ease-out); }
  .line span.out { transform: translateY(-100%); opacity: 0; }
  .line span.in { transform: translateY(100%); opacity: 0; }
  .now small { display: block; font-size: 12px; color: var(--mute); margin-top: 1px; }
  .bar { height: 2px; background: var(--eclipse); margin-top: 8px; border-radius: 2px; overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--ember); transform-origin: left; transform: scaleX(0); }
  .player .key { padding: 12px 18px; font-size: 14px; }

  /* The page moves with the scroll: a section arrives as it comes up, the
     rows draw their own lines, the window changes screen. Scroll timelines
     run off the main thread; without them the page is just still. Nothing
     here may hide what is on screen: the content is the page, and a fade
     that takes it down to a tenth reads as a bug, not as a transition. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* A section arrives as it comes up from the bottom and stays lit for
         the whole time it is on screen. It used to crossfade: down to a
         tenth of its opacity on the way in and on the way out, which is
         what made the page look empty in the middle of a scroll — the
         text was there, at ten percent, and the eye read it as gone. */
      .ring > .wrap { animation: arrive linear both; animation-timeline: view(); animation-range: entry 0% entry 100%; }
      .ring h2 { animation: title linear both; animation-timeline: view(); animation-range: entry 5% entry 60%; }
      @keyframes arrive {
        from { opacity: 0; transform: translateY(56px); }
        to { opacity: 1; transform: none; }
      }
      @keyframes title {
        from { opacity: 0; transform: translateY(0.5em); }
        to { opacity: 1; transform: none; }
      }

      /* Leaving the pool: the words lift away faster than the page and the
         liquid sinks into the floor, so the dish it sits in shows through.
         The fade lasts the whole way out: if it ended halfway, there was a
         stretch of page with the hero gone and the next section not yet
         arrived — a screen with nothing on it. */
      .hero { view-timeline: --hero; }
      .pitch, .top { animation: lift linear both; animation-timeline: --hero; animation-range: exit 0% exit 100%; }
      #ferro { animation: sink linear both; animation-timeline: --hero; animation-range: exit 0% exit 90%; }
      @keyframes lift { to { opacity: 0; transform: translateY(-12vh); } }
      @keyframes sink { to { opacity: 0.2; } }

      /* Each row draws its own hairline from the left as it arrives, and its
         words follow the line in. The borders stay in the base styles for
         browsers that can't run this. */
      .promise, .fact, .lead, .tracks li, .nots li { position: relative; view-timeline: --row; }
      .promise, .fact, .lead { border-top-color: transparent; }
      .tracks li, .nots li { border-bottom-color: transparent; }
      .promise::before, .fact::before, .lead::before, .tracks li::after, .nots li::after {
        content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 1px; background: var(--line);
        transform-origin: left; animation: draw linear both; animation-timeline: --row; animation-range: entry 0% entry 100%;
      }
      .tracks li::after, .nots li::after { top: auto; bottom: -1px; }
      .lead::before { background: rgb(237 234 227 / 0.45); }
      .promise h3, .fact h3, .lead h3 { animation: slide linear both; animation-timeline: --row; animation-range: entry 20% entry 100%; }
      .promise p, .fact p, .lead p, .nots p { animation: rise linear both; animation-timeline: --row; animation-range: entry 40% cover 45%; }
      .lead li { animation: rise linear both; animation-timeline: --row; }
      .lead li:nth-child(1) { animation-range: cover 20% cover 40%; }
      .lead li:nth-child(2) { animation-range: cover 30% cover 50%; }
      @keyframes draw { from { transform: scaleX(0); } to { transform: none; } }
      @keyframes slide { from { opacity: 0; transform: translateX(-18px); } to { opacity: 1; transform: none; } }
      @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

      /* The two tall sections hold still while the page runs under them. Their
         own fade replaces the section crossfade, which over a section three
         screens tall would leave them half-faded while pinned. The pin lights
         up as the section comes in and leaves as it goes out: a range of
         "entry 80%" meant two thousand pixels of scrolling with the window
         still at a tenth, and the screen black in the seam between the two
         sections. */
      .ring.tall { height: 340vh; padding: 0; view-timeline: --sec; }
      #dj.tall { height: 260vh; }
      .ring.tall > .wrap { animation: none; height: 100%; }
      .pin { position: sticky; top: 0; min-height: 100svh; display: grid; align-content: center; padding: 48px 0 110px; animation: arrive linear both, leave linear forwards; animation-timeline: --sec, --sec; animation-range: entry 0% entry 30%, exit 0% exit 100%; }
      @keyframes leave { to { opacity: 0; transform: translateY(-40px); } }

      /* The window tips up off the desk as it arrives, then changes screen as
         the hand scrolls: one picture holds, the next one fades in over it.
         The tip is tied to the pin's arrival: over "entry 100%" of a section
         three screens tall it was still tilting a thousand pixels later. */
      .window { transform-origin: 50% 100%; animation: tilt linear both; animation-timeline: --sec; animation-range: entry 0% entry 30%; }
      @keyframes tilt { from { opacity: 0.3; transform: perspective(1400px) rotateX(22deg) scale(0.9); } to { opacity: 1; transform: none; } }
      .shot, .steps li { animation: linear both; animation-timeline: --sec; animation-range: contain 0% contain 100%; }
      .shot:nth-child(1), .steps li:nth-child(1) { animation-name: s1; }
      .shot:nth-child(2), .steps li:nth-child(2) { animation-name: s2; }
      .shot:nth-child(3), .steps li:nth-child(3) { animation-name: s3; }
      .shot:nth-child(4), .steps li:nth-child(4) { animation-name: s4; }
      /* Holds with short fades between them: a screen stays, then the next.
         The list dims to --off rather than out: it is the tracklist, and the
         tracks that are not playing are still on it. */
      @keyframes s1 { 0%, 20% { opacity: 1; } 27%, 100% { opacity: var(--off, 0); } }
      @keyframes s2 { 0%, 20% { opacity: var(--off, 0); } 27%, 45% { opacity: 1; } 52%, 100% { opacity: var(--off, 0); } }
      @keyframes s3 { 0%, 45% { opacity: var(--off, 0); } 52%, 70% { opacity: 1; } 77%, 100% { opacity: var(--off, 0); } }
      @keyframes s4 { 0%, 70% { opacity: var(--off, 0); } 77%, 100% { opacity: 1; } }
      /* Dimmed, not gone: the step that is not playing still has to be read. */
      .steps li { --off: 0.45; }

      /* The DJ draws its ring, then says its line a word at a time while the
         section holds; the song it chose comes in last. The words that were
         not said yet stay legible: at a sixteenth they were a ghost of a
         sentence, and the section read as empty until it was said. */
      .dj-mark circle { animation: ring linear both; animation-timeline: --sec; animation-range: contain 0% contain 20%; }
      @keyframes ring { from { stroke-dasharray: 0 239; } to { stroke-dasharray: 212 27; } }
      .dj-line .w { animation: say linear both; animation-timeline: --sec; }
      @keyframes say { from { opacity: 0.4; } to { opacity: 1; } }
      .dj-next { animation: rise linear both; animation-timeline: --sec; animation-range: contain 84% contain 94%; }

      /* Each thing it doesn't do is crossed out as it reaches the middle of
         the screen, and goes grey once it is. */
      .nots h3 { color: var(--frost); animation: grey linear both; animation-timeline: --row; animation-range: cover 30% cover 48%; }
      .nots h3 span { background-size: 0% 2px; animation: strike linear both; animation-timeline: --row; animation-range: cover 30% cover 45%; }
      @keyframes grey { to { color: var(--mute); } }
      @keyframes strike { to { background-size: 100% 2px; } }

      /* The playhead crosses the two songs as the section crosses the screen. */
      .playhead { display: block; animation: play linear both; animation-timeline: view(); animation-range: cover 25% cover 75%; }
      @keyframes play { from { left: 0; } to { left: 100%; } }

      /* The feature list is a playlist whose current track is the one in the
         middle of the screen: it comes up to full light and a meter starts
         on its beat. The rest wait, dimmed. The number stays: the meter used
         to take its place, and a digit that vanishes is a thing the reader
         looks for and does not find. */
      .tracks li { animation: enter linear both; animation-timeline: --row; animation-range: entry 0% entry 100%; }
      .tracks li > * { animation: focus linear both; animation-timeline: --row; animation-range: cover 0% cover 100%; }
      .tracks .n { position: relative; }
      /* The meter sits next to the number, not on it. */
      .eq { display: flex; position: absolute; right: 12px; bottom: 3px; height: 12px; gap: 2px; align-items: end; opacity: 0; animation: meter linear both; animation-timeline: --row; animation-range: cover 42% cover 58%; }
      .eq b { width: 3px; height: 100%; background: var(--frost); border-radius: 1px; transform-origin: bottom; animation: bounce 268ms ease-in-out infinite alternate; }
      .eq b:nth-child(2) { animation-delay: -120ms; }
      .eq b:nth-child(3) { animation-delay: -210ms; }
      @keyframes enter { from { transform: translateY(24px); } to { transform: none; } }
      /* The row in the middle of the screen comes up to full light and the
         rest wait for it. Dimmed, not gone: at three tenths the rows that
         were not playing could not be read. */
      @keyframes focus { 0%, 32%, 68%, 100% { opacity: 0.45; } 46%, 54% { opacity: 1; } }
      @keyframes meter { 0%, 100% { opacity: 0; } 30%, 70% { opacity: 1; } }
      /* 268ms each way is one full bar up and down per beat at 112 BPM. */
      @keyframes bounce { from { transform: scaleY(0.3); } to { transform: none; } }

      footer { animation: arrive linear both; animation-timeline: view(); animation-range: entry 0% entry 100%; }
    }
  }
  @media (prefers-reduced-motion: reduce) { .line span { transition: none; } }
  @media (max-width: 860px) {
    .top nav { gap: 18px; }
    .top nav a:not(:last-of-type) { display: none; }
    /* On a phone the pool gets its own band of the hero, so the words can
       never end up on top of it however short the window is. */
    .hero { grid-template-rows: auto auto 1fr; }
    .stage { display: block; height: clamp(220px, 78vw, 420px); }
    .pitch { align-self: start; padding-bottom: 110px; }
    .promise, .before { grid-template-columns: 1fr; gap: 14px; }
    .before { gap: 32px; }
    /* On a phone the window goes first and only the playing step is told:
       four steps and a window don't fit one pinned screen. */
    .shots { grid-template-columns: 1fr; gap: 24px; margin-top: 28px; }
    .window { order: -1; }
    .steps { display: grid; border-top: 0; }
    .steps li { grid-area: 1 / 1; border-bottom: 0; padding: 0; --off: 0; }
    .steps li + li { opacity: 0; }
    .dj { grid-template-columns: 1fr; gap: 28px; margin-top: 32px; }
    .dj-mark { width: 120px; }
    .nots li { grid-template-columns: 1fr; gap: 8px; }
    .tracks li { grid-template-columns: 28px minmax(0, 1fr) auto; row-gap: 6px; }
    .tracks .n { grid-area: 1 / 1; }
    .tracks h3 { grid-area: 1 / 2; }
    .tracks .v { grid-area: 1 / 3; }
    .tracks p { grid-area: 2 / 2 / 3 / 4; }
    .player .key span { display: none; }
    .player .key { padding: 12px 14px; }
  }
</style>
</head>
<body>
<main>
  <section class="hero" id="inicio" data-track="Starless" data-track-es="Starless">
    <canvas id="ferro" aria-hidden="true"></canvas>
    <header class="top">
      <span class="brand"><img src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/starless.svg`} alt="" width="28" height="28" /><span class="sl-wordmark">starless</span><span class="beta">Beta</span></span>
      <nav aria-label="Sections" data-es-label="Secciones"><a href="#que-hace" data-es="Qué hace">What it does</a><a href="#antes" data-es="Antes de instalar">Before you install</a><a href="https://github.com/baironvillar/Starless">GitHub</a><button class="lang" type="button" aria-label="Ver en español" data-es-label="View in English"><span lang="en">EN</span><span lang="es">ES</span></button></nav>
    </header>
    <div class="stage" aria-hidden="true"></div>
    <div class="pitch">
      <div class="plate sl-glass"><img src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/starless-glass.svg`} alt="" width="128" height="128" /></div>
      <h1 class="sl-wordmark">starless</h1>
      <p data-es="Un cliente de escritorio liviano y no oficial para tu cuenta Premium. Suena directo y no le cuenta a nadie lo que escuchas.">A light, unofficial desktop client for your Premium account. It plays straight to your speakers and tells no one what you listen to.</p>
      <a class="key" href="https://github.com/baironvillar/Starless/releases/download/v0.5.5/Starless_0.5.5_x64.msi" data-msi>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-5-5m5 5l5-5M5 20h14"/></svg>
        <span data-es="Descargar para Windows">Download for Windows</span>
        <span class="size nums" data-size>8.1 MB</span>
      </a>
      <p class="fine nums" data-es="En beta · Windows 10 y 11 · Requiere Premium">In beta · Windows 10 and 11 · Requires Premium</p>
    </div>
  </section>

  <section class="ring" id="promesas" data-track="What it promises" data-track-es="Lo que promete">
    <div class="wrap">
      <h2 data-es="Solo se mueve la música.">Only the music moves.</h2>
      <div class="promises">
        <div class="promise"><h3 data-es="La ventana llega primero">The window comes first</h3><p data-es="Abre antes de que termine de conectar, y el audio nunca pasa por ella: va de la red directo al driver de sonido.">It opens before it has finished connecting, and the audio never goes through it: it travels from the network straight to the sound driver.</p></div>
        <div class="promise"><h3 data-es="Hecha para moverse">Made to move</h3><p data-es="Las pantallas, la barra que llega con la música y la cola se diseñaron juntas, no se agregaron después.">The screens, the bar that arrives with the music and the queue were designed together, not bolted on later.</p></div>
        <div class="promise"><h3 data-es="Cero telemetría">Zero telemetry</h3><p data-es="Starless no le reporta nada a nadie, ni a su autor. Solo sale algo de tu equipo si tú envías un reporte, y antes ves qué se envía.">Starless reports nothing to anyone, not even to its author. Something only leaves your computer if you send a report, and you see what it carries first.</p></div>
      </div>
    </div>
  </section>

  <section class="ring tall" id="app" data-track="How it looks" data-track-es="Así se ve">
    <div class="wrap">
      <div class="pin">
        <h2 data-es="Una ventana que no pide atención.">A window that doesn't ask for attention.</h2>
        <div class="shots">
          <ol class="steps">
            <li><h3 data-es="Tu biblioteca">Your library</h3><p data-es="Tus playlists y tus discos, apenas abres.">Your playlists and albums, the moment you open it.</p></li>
            <li><h3 data-es="Una playlist">A playlist</h3><p data-es="Portada, nombre y descripción, editables ahí mismo.">Cover, name and description, editable right there.</p></li>
            <li><h3 data-es="La cola">The queue</h3><p data-es="Lo que suena y lo que viene, encima de lo que estás viendo.">What's playing and what's next, over whatever you're looking at.</p></li>
            <li><h3 data-es="A tu gusto">Your way</h3><p data-es="El color de acento y qué tan sólidos se ven los menús.">The accent colour, and how solid the menus look.</p></li>
          </ol>
          <figure class="window" aria-label="Starless screens" data-es-label="Pantallas de Starless">
            <div class="shot"><Screen variant="library" /></div>
            <div class="shot"><Screen variant="playlist" /></div>
            <div class="shot"><Screen variant="queue" /></div>
            <div class="shot"><Screen variant="settings" /></div>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="ring tall" id="dj" data-track="The DJ" data-track-es="El DJ">
    <div class="wrap">
      <div class="pin">
        <h2 data-es="Un DJ que te habla.">A DJ that talks to you.</h2>
        <p class="lede" data-es="Elige la música y, antes de cada tramo, te la presenta con su voz. No hay lista de lo que viene: lo siguiente es sorpresa.">It picks the music and, before each stretch, introduces it in its own voice. There's no list of what's coming: what comes next is a surprise.</p>
        <div class="dj">
          <svg class="dj-mark" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="38" /></svg>
          <div>
            <p class="dj-who" data-es="DJ · Hablando">DJ · Speaking</p>
            <p class="dj-line" id="dj-line" data-es="Buenas noches. Empezamos tranquilos, con algo para bajarle el ritmo al día, y de a poco vamos subiendo. Esta primera se escucha mejor con los ojos cerrados.">Good evening. We'll start slow, with something to bring the day down a notch, and build up bit by bit. This first one sounds best with your eyes closed.</p>
            <p class="dj-next" data-es="Y en cuanto termina la frase, suena la canción que eligió.">And the moment the line ends, the song it chose starts playing.</p>
          </div>
        </div>
        <p class="caption" data-es="Frase de muestra: cada sesión del DJ dice la suya.">A sample line: every DJ session says its own.</p>
      </div>
    </div>
  </section>

  <section class="ring" id="que-hace" data-track="What it does" data-track-es="Lo que hace">
    <div class="wrap">
      <h2 data-es="Lo que hace.">What it does.</h2>
      <ol class="tracks">
        <li><span class="n nums"><span>1</span><i class="eq" aria-hidden="true"><b></b><b></b><b></b></i></span><h3 data-es="El DJ habla">The DJ talks</h3><p data-es="Elige la música y la presenta con su voz, antes de cada tramo.">It picks the music and introduces it in its voice, before each stretch.</p><span class="v nums">0.5.0</span></li>
        <li><span class="n nums"><span>2</span><i class="eq" aria-hidden="true"><b></b><b></b><b></b></i></span><h3 data-es="La radio sigue">The radio carries on</h3><p data-es="Cuando la lista se acaba, sigue con canciones parecidas.">When the list runs out, it keeps going with similar songs.</p><span class="v nums">0.5.5</span></li>
        <li><span class="n nums"><span>3</span><i class="eq" aria-hidden="true"><b></b><b></b><b></b></i></span><h3 data-es="Tus playlists, editables">Your playlists, editable</h3><p data-es="Portada, nombre, descripción y privada o pública, sin salir de la app.">Cover, name, description, and private or public, without leaving the app.</p><span class="v nums">0.5.4</span></li>
        <li><span class="n nums"><span>4</span><i class="eq" aria-hidden="true"><b></b><b></b><b></b></i></span><h3 data-es="Se actualiza sola">It updates itself</h3><p data-es="Avisa cuando hay versión nueva y la instala cuando tú quieras.">It tells you when there's a new version and installs it when you say so.</p><span class="v nums">0.3.0</span></li>
        <li><span class="n nums"><span>5</span><i class="eq" aria-hidden="true"><b></b><b></b><b></b></i></span><h3 data-es="Transición entre canciones">Crossfade</h3><p data-es="Una baja mientras la otra sube; tú eliges cuántos segundos.">One fades out as the next comes in; you choose how many seconds.</p><span class="v nums soon">1.0</span></li>
        <li><span class="n nums"><span>6</span><i class="eq" aria-hidden="true"><b></b><b></b><b></b></i></span><h3 data-es="Un jam con amigos">A jam with friends</h3><p data-es="Empieza una sesión compartida, pasa su código y ve quién escucha contigo.">Start a shared session, pass on its code, and see who's listening with you.</p><span class="v nums soon">1.0</span></li>
        <li><span class="n nums"><span>7</span><i class="eq" aria-hidden="true"><b></b><b></b><b></b></i></span><h3 data-es="Las letras">Lyrics</h3><p data-es="La letra sigue a la canción, al lado de su portada o en pantalla completa.">The words follow the song, beside its cover or full screen.</p><span class="v nums soon">1.0</span></li>
      </ol>
    </div>
  </section>

  <section class="ring" id="mezcla" data-track="The crossfade" data-track-es="La transición">
    <div class="wrap">
      <h2 data-es="Una baja mientras la otra sube.">One fades out as the next comes in.</h2>
      <p class="lede" data-es="La transición entre canciones llega en la 1.0. Mueve el control y mira cómo se cruzan: de 0 a 12 segundos, como en la app.">Crossfade arrives in 1.0. Move the slider and watch the two songs cross: from 0 to 12 seconds, as in the app.</p>
      <div class="mix">
        <div class="mix-wave">
          <span class="mix-a" data-es="La que termina">The one ending</span>
          <svg id="mix" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true"></svg>
          <span class="mix-b" data-es="La que empieza">The one starting</span>
          <i class="playhead" aria-hidden="true"></i>
        </div>
        <div class="mix-ctl">
          <label for="xfade" data-es="Cruce">Overlap</label>
          <input type="range" id="xfade" min="0" max="12" step="1" value="6" />
          <output for="xfade" id="xfade-out" class="nums">6 s</output>
        </div>
      </div>
    </div>
  </section>

  <section class="ring" id="sin" data-track="What it doesn't do" data-track-es="Lo que no hace">
    <div class="wrap">
      <h2 data-es="Lo que no hace.">What it doesn't do.</h2>
      <ul class="nots">
        <li><h3><span data-es="Contar lo que escuchas">Tell anyone what you listen to</span></h3><p data-es="Cero telemetría. No hay nada que apagar, porque nunca se encendió.">Zero telemetry. There's nothing to switch off, because it was never on.</p></li>
        <li><h3><span data-es="Enviar algo sin que hagas clic">Send anything without your click</span></h3><p data-es="Un reporte de error sale solo si tú lo mandas, y antes ves qué lleva.">An error report only leaves if you send it, and you see what it carries first.</p></li>
        <li><h3><span data-es="Pedirte un segundo permiso">Ask you for a second permission</span></h3><p data-es="Entras una vez con tu cuenta. No hay otra pantalla de autorización ni otra identidad.">You sign in once with your account. There's no second authorisation screen and no second identity.</p></li>
        <li><h3><span data-es="Pasar el audio por una página web">Run the audio through a web page</span></h3><p data-es="El sonido va directo al driver de Windows. Por eso arranca rápido y gasta poca memoria.">Sound goes straight to the Windows driver. That's why it starts fast and uses little memory.</p></li>
        <li><h3><span data-es="Cobrarte">Charge you</span></h3><p data-es="Es gratis y de código abierto, con licencia MIT. Puedes leer cada línea.">It's free and open source, under the MIT licence. You can read every line.</p></li>
      </ul>
    </div>
  </section>

  <section class="ring" id="antes" data-track="Before you install" data-track-es="Antes de instalar">
    <div class="wrap">
      <h2 data-es="Antes de instalar.">Before you install.</h2>
      <div class="before">
        <div class="lead">
          <h3 data-es="Windows te va a avisar">Windows will warn you</h3>
          <p data-es="El instalador todavía no está firmado, así que verás “Windows protegió tu PC”. Se pasa así:">The installer isn't signed yet, so you'll see “Windows protected your PC”. Here's how to get past it:</p>
          <ol><li data-es="Toca <b>Más información</b>.">Click <b>More info</b>.</li><li data-es="Toca <b>Ejecutar de todas formas</b>.">Click <b>Run anyway</b>.</li></ol>
        </div>
        <div>
          <div class="fact"><h3 data-es="Necesitas Premium">You need Premium</h3><p data-es="Es una condición de la tecnología que reproduce el audio: las cuentas gratuitas no funcionan.">It's a condition of the technology that plays the audio: free accounts don't work.</p></div>
          <div class="fact"><h3 data-es="Es no oficial">It's unofficial</h3><p data-es="Un proyecto independiente. Si el servicio cambia algo por dentro, puede dejar de funcionar unos días.">An independent project. If the service changes something under the hood, it can stop working for a few days.</p></div>
          <div class="fact"><h3 data-es="Tu contraseña no pasa por Starless">Your password never goes through Starless</h3><p data-es="Inicias sesión en tu navegador, en la página oficial del servicio. Starless recibe un permiso para reproducir y nunca ve tu contraseña.">You sign in in your browser, on the service's official page. Starless receives a permission to play and never sees your password.</p></div>
          <div class="fact"><h3 data-es="Usarla es decisión tuya">Using it is your call</h3><p data-es="El servicio no autoriza clientes no oficiales. Starless solo reproduce lo que tu cuenta ya puede reproducir y no convierte canciones en archivos, pero nadie puede prometerte que el servicio nunca actúe sobre una cuenta.">The service doesn't authorise unofficial clients. Starless only plays what your account can already play and doesn't turn songs into files, but no one can promise you the service will never act on an account.</p></div>
          <div class="fact"><h3 data-es="Por ahora, solo Windows">Windows only, for now</h3><p data-es="macOS y Linux vienen después de que Windows esté firmado y estable.">macOS and Linux come once Windows is signed and stable.</p></div>
        </div>
      </div>
    </div>
  </section>
</main>

<footer id="fin">
  <span data-es="Starless es un proyecto independiente, sin relación con el servicio de música que reproduce.">Starless is an independent project, unaffiliated with the music service it plays.</span>
  <span>MIT · <a href="https://github.com/baironvillar/Starless">GitHub</a></span>
</footer>

<div class="player sl-glass" role="region" aria-label="Player and download" data-es-label="Reproductor y descarga">
  <canvas class="dot" id="dot" width="84" height="84" aria-hidden="true"></canvas>
  <div class="now">
    <div class="line"><span id="title-now">Starless</span></div>
    <small class="nums" data-es="En beta · Para Windows">In beta · For Windows</small>
    <div class="bar" aria-hidden="true"><i id="progress"></i></div>
  </div>
