# Store text as LF in the repository, check out per platform.
#
# The project was authored on Windows, so a few files started with CRLF. With
# this in place that stops mattering: git normalizes on the way in, and the
# working tree can keep whatever the editor prefers without producing a diff.
* text=auto eol=lf

# The impeccable launcher is a POSIX sh script. Claude Code runs it from hooks
# under sh, and a CRLF in a shell script fails in a way that surfaces as a
# mystery, not as a line-ending complaint.
.agent/skills/impeccable/scripts/impeccable text eol=lf

# Windows shims are run by cmd.exe, which needs CRLF.
*.cmd text eol=crlf

# Binaries. Not one of these can survive a round trip through git's text
# filter, and the icons and the skill binary are already compressed.
*.exe binary
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.msi binary

# Generated by Cargo; never in the repository.
src-tauri/target/** binary
src-tauri/Cargo.lock linguist-generated=true
bun.lock linguist-generated=true
