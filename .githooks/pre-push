#!/usr/bin/env sh
#
# The branch rule of Starless, in one place.
#
#     develop          integration: every change lands here through a pull request
#     main             the public line: only `develop` is merged into it
#     type/short-name  everything else, cut from `develop`, in English, kebab-case
#     release/0.5.5    the branch that bumps the version
#
# It is used in two ways, and it is the same file on purpose:
#
#     sh .githooks/pre-push <remote> <url>   # what git runs, refs on stdin
#     sh .githooks/pre-push --branch <name>  # what CI runs on a pull request
#
# A push of a tag is never blocked: publishing a release is `git push origin
# v0.5.5`, and the tag points at a commit that already reached `develop` through
# a pull request.

set -u

tipos='feat|fix|refactor|perf|docs|test|build|ci|chore|style|revert|hotfix'
nombre='[a-z0-9]+(-[a-z0-9]+)*'
version='[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?'
max=60

fallar_nombre() {
	cat >&2 <<FINAL

The branch name does not follow the convention of this repo.

  branch: "$1"

A branch is named type/short-description, in English, lowercase, kebab-case,
up to $max characters, or release/<version> for a version bump:

  fix/configuration-button
  feat/playlist-cover-upload
  docs/branching-workflow
  hotfix/updater-crash-on-start
  release/0.5.5

Types: feat fix refactor perf docs test build ci chore style revert hotfix

Rename it with:  git branch -m <new-name>

FINAL
	exit 1
}

fallar_protegida() {
	cat >&2 <<FINAL

Direct pushes to "$1" are not allowed.

Every change reaches develop through a pull request from its own branch, and
main only receives develop. Move your commits to a branch and open a PR:

  git switch -c fix/short-description
  git push -u origin fix/short-description

FINAL
	exit 1
}

validar() {
	rama="$1"
	largo=$(printf '%s' "$rama" | wc -c | tr -d ' ')
	[ "$largo" -le "$max" ] || fallar_nombre "$rama"
	printf '%s' "$rama" | grep -Eq "^(($tipos)/$nombre|release/$version)$" ||
		fallar_nombre "$rama"
}

case "${1-}" in
--branch)
	[ -n "${2-}" ] || {
		echo "usage: sh .githooks/pre-push --branch <name>" >&2
		exit 2
	}
	validar "$2"
	exit 0
	;;
esac

ceros='0000000000000000000000000000000000000000'

while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
	refs/heads/*) ;;
	*) continue ;;
	esac

	rama=${remote_ref#refs/heads/}

	# Deleting a remote branch after its PR is merged is housekeeping, not a
	# change, so its name is not judged.
	[ "$local_sha" = "$ceros" ] && continue

	case "$rama" in
	main | develop) fallar_protegida "$rama" ;;
	esac

	validar "$rama"
done

exit 0
